<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (full-backup-content). Automatic backup is already off
  with android:allowBackup="false"; these rules are the second barrier so a
  later manifest change cannot silently start uploading the vault.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
